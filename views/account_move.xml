<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hide_credit_btn_from_return_inv_view" model="ir.ui.view">
        <field name="name">hide_credit_btn_from_return_inv_view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_reverse']" position="attributes">
                        <attribute name="invisible">move_type in ('out_refund','in_refund')</attribute>
                </xpath>  
                <xpath expr="//button[@name='action_view_debit_notes']" position="attributes">
                        <attribute name="groups">yousentech_zatca_validation.group_use_invoice_debit_note</attribute>
                </xpath>  
           </field>
    </record>
</odoo>